---
import { SITE } from '~/config.mjs';

import { getCanonical, getHomePermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';

import HeroPersonal from '~/components/widgets/HeroPersonal.astro';
import About from '~/components/widgets/About.astro';
import Skills from '~/components/widgets/Skills.astro';
import Server from '~/components/widgets/Server.astro';
import EducationContact from '~/components/widgets/EducationContact.astro';

const meta = {
  title: SITE.title,
  description: SITE.description,
  canonical: getCanonical(getHomePermalink()),
};
---

<Layout {meta}>
  <HeroPersonal />
  <About />
  <Skills />
  <Server />
  <EducationContact />
</Layout>
