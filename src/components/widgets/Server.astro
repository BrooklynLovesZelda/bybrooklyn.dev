---
const server = {
  name: 'Harvey V3',
  description:
    'My home server where I self-host services and experiment with Linux. I lean on Docker and Portainer to keep things organized while I tinker, monitor, and occasionally break things on purpose to learn.',
  stack: [
    'Linux host',
    'Docker and Portainer',
    'Self-hosted services',
    'Performance and stability tuning',
    'Status: status.bybrooklyn.dev/status/server',
  ],
};
---

<section class="scroll-mt-20 border-t border-slate-200 dark:border-slate-800" id="server">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="glass-card p-6 sm:p-7 transition-shadow duration-200 hover:shadow-2xl hover:shadow-slate-900/15">
      <div
        class="pointer-events-none absolute inset-0 rounded-[32px] bg-gradient-to-br from-white/50 via-white/5 to-transparent opacity-70 dark:from-white/10 dark:via-white/5"
        aria-hidden="true"
      />
      <div class="relative space-y-4">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-300">
          Server / Lab
        </p>
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white font-heading">
          {server.name}
        </h2>
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">{server.description}</p>
        <div class="flex flex-wrap gap-2">
          {
            server.stack.map((item) => (
              <span
                class="rounded-full border border-white/30 bg-white/30 px-3 py-1 text-sm font-semibold text-blue-700 backdrop-blur dark:border-white/10 dark:bg-white/10 dark:text-blue-200"
              >
                {item}
              </span>
            ))
          }
        </div>
        <div class="pt-2">
          <a
            href="https://status.bybrooklyn.dev/status/server"
            class="inline-flex items-center gap-2 text-blue-700 font-semibold hover:underline dark:text-blue-300"
          >
            View server status
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
