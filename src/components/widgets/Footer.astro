---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';

const home = getHomePermalink();
const anchor = (id: string) => `${home}#${id}`;

const links = [
  {
    title: 'Explore',
    items: [
      { title: 'About', href: anchor('about') },
      { title: 'Interests', href: anchor('interests') },
      { title: 'Skills', href: anchor('skills') },
    ],
  },
  {
    title: 'Workbench',
    items: [
      { title: 'Harvey V3 server', href: anchor('server') },
      { title: 'Status page', href: 'https://status.bybrooklyn.dev/status/server' },
      { title: 'Education', href: anchor('education') },
    ],
  },
  {
    title: 'Connect',
    items: [
      { title: 'GitHub', href: 'https://github.com/BrooklynLovesZelda' },
      { title: 'LinkedIn', href: 'https://www.linkedin.com/in/zakary-halmstad-741211315/' },
    ],
  },
];

const social = [
  { label: 'Github', icon: 'tabler:brand-github', href: 'https://github.com/BrooklynLovesZelda' },
  {
    label: 'LinkedIn',
    icon: 'tabler:brand-linkedin',
    href: 'https://www.linkedin.com/in/zakary-halmstad-741211315/',
  },
];

const SITE_VERSION = 'v0.2-1';
---

<footer class="relative border-t border-gray-200 dark:border-slate-800 not-prose">
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block font-bold text-xl" href={getHomePermalink()}>Bybrooklyn.dev</a>
        <p class="text-sm text-muted mt-2 max-w-md">
          Student and hands-on tinkerer who learns by building, breaking, and fixing computers and
          servers.
        </p>
      </div>
      {
        links.map(({ title, items }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="dark:text-gray-300 font-medium mb-2">{title}</div>
            {items && Array.isArray(items) && items.length > 0 && (
              <ul class="text-sm">
                {items.map(({ title, href }) => (
                  <li class="mb-2">
                    <a
                      class="text-muted hover:text-gray-700 dark:text-gray-400 hover:underline transition duration-150 ease-in-out mr-2 rtl:mr-0 rtl:ml-2"
                      href={href}
                    >
                      {title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8">
      <ul
        class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 md:rtl:ml-0 md:rtl:mr-4"
      >
        {
          social.map(({ label, href, icon }) => (
            <li>
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-hidden focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-full text-sm p-2.5 inline-flex items-center"
                aria-label={label}
                href={href}
              >
                <Icon name={icon} class="w-5 h-5" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="text-sm mr-4 dark:text-slate-400">
        Built by Brook. Forked from the CachyOS website –
        <a
          class="text-blue-600 dark:text-white font-bold decoration-slate-400 decoration-dotted underline"
          href="https://github.com/cachyos/cachyos.org"
        >
          source on GitHub
        </a
        >. Thanks for stopping by.
        <span
          class="ml-2 inline-flex items-center rounded-full border border-gray-200 px-2 py-1 text-xs font-semibold text-gray-600 dark:text-gray-300 dark:border-slate-700"
        >
          {SITE_VERSION}
        </span>
      </div>
    </div>
  </div>
</footer>
