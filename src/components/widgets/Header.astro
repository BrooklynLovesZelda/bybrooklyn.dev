---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { getHomePermalink, getPermalink } from '~/utils/permalinks';

const sectionLink = (id: string) => getPermalink(`/#${id}`);

const navItems = [
  { href: sectionLink('about'), text: 'About' },
  { href: sectionLink('interests'), text: 'Interests' },
  { href: sectionLink('skills'), text: 'Skills' },
  { href: sectionLink('server'), text: 'Server' },
  { href: 'https://status.bybrooklyn.dev/status/server', text: 'Status' },
  { href: sectionLink('education'), text: 'Education' },
  { href: sectionLink('contact'), text: 'Contact' },
];
const githubUrl = 'https://github.com/BrooklynLovesZelda';
const linkedinUrl = 'https://www.linkedin.com/in/zakary-halmstad-741211315/';
---

<header
  class="sticky top-0 z-40 flex-none transition-colors w-full duration-500 lg:z-50"
  id="header"
>
  <div class="mx-auto w-full max-w-6xl px-4 pt-4 pb-3 md:px-6">
    <div
      class="glass-nav md:flex md:items-center md:justify-between text-slate-700 font-semibold text-sm leading-6 dark:text-slate-200 px-3 py-2 md:px-4 md:py-3"
    >
      <a class="hidden md:flex md:items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex justify-between md:hidden w-full items-center gap-3">
        <a class="flex items-center" href={getHomePermalink()}>
          <Logo />
        </a>
        <div class="flex items-center gap-1">
          <ToggleTheme />
          <ToggleMenu />
        </div>
      </div>
      <nav
        class="items-center w-full md:z-60 md:w-auto md:flex text-gray-600 dark:text-slate-200 h-[calc(100vh-100px)] md:h-auto overflow-y-auto md:overflow-visible hidden"
        aria-label="Main navigation"
      >
        <ul
          class="flex flex-col md:flex-row md:items-center md:self-center w-full md:w-auto gap-2 md:gap-6 text-lg md:text-sm font-semibold"
        >
          {
            navItems.map(({ href, text }) => (
              <li>
                <a
                  class="group relative block rounded-full px-4 py-2 md:px-0 md:py-1 hover:text-gray-900 dark:hover:text-white transition duration-200 ease-out"
                  href={href}
                >
                  <span
                    class="pointer-events-none absolute inset-x-1 bottom-1 h-0.5 scale-x-0 origin-left rounded-full bg-blue-500/70 transition duration-200 ease-out group-hover:scale-x-100 md:bottom-0.5"
                    aria-hidden="true"
                    data-underline
                  />
                  {text}
                </a>
              </li>
            ))
          }
          <li class="md:hidden">
            <a
              class="font-bold hover:text-gray-900 dark:hover:text-white px-4 py-3 flex items-center transition duration-150 ease-in-out"
              href={githubUrl}
            >
              Github
            </a>
          </li>
        </ul>
        <div class="md:self-center flex items-center mb-4 md:mb-0 ml-2">
          <div class="hidden items-center md:flex">
            <ToggleTheme iconClass="w-5 h-5" />
            <a
              href={githubUrl}
              class="inline-block text-gray-500 dark:text-gray-400 hover:bg-white/30 dark:hover:bg-white/10 focus:outline-hidden focus:ring-2 focus:ring-white/40 dark:focus:ring-white/20 rounded-full text-sm p-2.5 transition"
              aria-label="Github"
            >
              <Icon name="tabler:brand-github" class="w-5 h-5" />
            </a>
            <a
              href={linkedinUrl}
              class="inline-block text-gray-500 dark:text-gray-400 hover:bg-white/30 dark:hover:bg-white/10 focus:outline-hidden focus:ring-2 focus:ring-white/40 dark:focus:ring-white/20 rounded-full text-sm p-2.5 transition"
              aria-label="LinkedIn"
            >
              <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
            </a>
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>
